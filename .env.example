# Copy this file to .env.local for local development.
# On Vercel, add the real values in Project Settings > Environment Variables.
# Never commit .env / .env.local.

# MongoDB connection string (server only)
MONGODB_URL=

# Random secret, at least 32 characters. Generate with `npx auth secret`
# or `openssl rand -base64 32`. Use the same value in every environment.
BETTER_AUTH_SECRET=

# Canonical auth URL (server only). Used as a fallback when a request has no host.
# Local: http://localhost:3000
# Production: https://bazardor-a07-mhr.vercel.app
BETTER_AUTH_URL=http://localhost:3000

# Public app URL. Inlined into the browser bundle at build time.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth app credentials. Callback: /api/auth/callback/google
BETTER_AUTH_GOOGLE_CLIENT_ID=
BETTER_AUTH_GOOGLE_SECRET=

# GitHub OAuth app credentials. Callback: /api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Aliases that are also accepted by the code (no need to set both):
# GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, NEXT_PUBLIC_BETTER_AUTH_URL
